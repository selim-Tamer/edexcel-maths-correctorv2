{
  "spec": {
    "name": "ai-maths-marker-backend-contract",
    "version": "0.1.0-draft",
    "status": "SPEC_NOT_IMPLEMENTED",
    "milestone": "M5 (C11 foundation + C10 contracts)",
    "framework_target": "FastAPI",
    "compute_target": "Google Cloud Run",
    "storage_target": "Supabase Postgres (+ private object storage for snapshots)",
    "provisioned": false,
    "deployed": false,
    "note": "The per-endpoint `implemented` flags are authoritative: they mark the routes served in-process by the dev API (tests drive it with fastapi.testclient). spec.status stays SPEC_NOT_IMPLEMENTED because the sign-off endpoint and the deployment posture are not implemented. fastapi/uvicorn are now production dependencies because api/server.py is the prepared container entrypoint (nothing is built, provisioned or deployed by this repository state), and every failure code is drawn from the existing source vocabulary - no code is invented. The browser mapping of these routes is contract/minimum_v1.json (PROPOSED, awaiting FCM)."
  },
  "error_envelope": {
    "description": "Every non-2xx response uses this shape. Codes are a subset of the existing source vocabulary.",
    "type": "object",
    "required": [
      "error"
    ],
    "properties": {
      "error": {
        "type": "object",
        "required": [
          "code",
          "message"
        ],
        "properties": {
          "code": {
            "type": "string"
          },
          "message": {
            "type": "string"
          },
          "detail": {
            "type": "string"
          }
        }
      }
    }
  },
  "auth": {
    "scheme": "Bearer (OIDC identity token)",
    "actor_is_not_tenant": true,
    "description": "The authenticated teacher is the ACTOR (owner scope), never the tenant. Tenant membership is resolved server-side from the actor. Authorization is re-verified fresh at every privileged action; no token or historical evidence is a reusable grant.",
    "server_side_checks": [
      "authenticated_identity_present",
      "tenant_membership_active",
      "resource_owner_match",
      "fresh_reverification_for_classroom_scope"
    ]
  },
  "endpoints": [
    {
      "method": "POST",
      "path": "/v1/results",
      "purpose": "Register one reviewed result and its immutable original AI output.",
      "implemented": true,
      "auth_required": true,
      "tenant_scoped": true,
      "request": {
        "type": "object",
        "required": [
          "scope",
          "original_output"
        ],
        "properties": {
          "scope": {
            "enum": [
              "classroom",
              "manual"
            ]
          },
          "classroom_identity": {
            "type": "object",
            "properties": {
              "course_id": {
                "type": "string"
              },
              "assignment_id": {
                "type": "string"
              },
              "submission_id": {
                "type": "string"
              },
              "revision": {
                "type": "string"
              }
            },
            "required": [
              "course_id",
              "assignment_id",
              "submission_id"
            ]
          },
          "manual_identity": {
            "type": "object",
            "description": "Opaque server-issued submission id bound to document digest + owner. No pupil name in the key.",
            "properties": {
              "submission_ref": {
                "type": "string"
              },
              "document_digest": {
                "type": "string"
              }
            },
            "required": [
              "document_digest"
            ]
          },
          "original_output": {
            "type": "object"
          }
        }
      },
      "response_201": {
        "type": "object",
        "required": [
          "result_id",
          "owner",
          "result_revision",
          "audit_reference"
        ],
        "properties": {
          "result_id": {
            "type": "string"
          },
          "owner": {
            "type": "string"
          },
          "result_revision": {
            "type": "integer"
          },
          "audit_reference": {
            "type": "string"
          },
          "supersedes": {
            "type": [
              "string",
              "null"
            ]
          }
        }
      },
      "error_codes": [
        "payload_invalid",
        "original_output_invalid",
        "store_unusable",
        "audit_store_unavailable"
      ]
    },
    {
      "method": "POST",
      "path": "/v1/results/{result_id}/decisions",
      "purpose": "Atomically commit one accepted teacher question-level decision together with its audit event.",
      "implemented": true,
      "auth_required": true,
      "tenant_scoped": true,
      "idempotent": true,
      "optimistic_concurrency": true,
      "request": {
        "type": "object",
        "required": [
          "question_number",
          "action",
          "expected_revision",
          "idempotency_key"
        ],
        "properties": {
          "question_number": {
            "type": [
              "string",
              "integer"
            ],
            "description": "Canonical identity is the stripped string (\"1\", \"2a\"). An integer is accepted and normalised, never stored as a number."
          },
          "action": {
            "enum": [
              "approve",
              "correct",
              "flag"
            ]
          },
          "review_status": {
            "type": "string"
          },
          "old_score": {
            "type": [
              "string",
              "null"
            ]
          },
          "new_score": {
            "type": [
              "string",
              "null"
            ]
          },
          "reason": {
            "type": "string",
            "maxLength": 2000
          },
          "binding": {
            "type": "string"
          },
          "expected_revision": {
            "type": "integer"
          },
          "idempotency_key": {
            "type": "string"
          }
        }
      },
      "response_200": {
        "type": "object",
        "required": [
          "result_id",
          "result_revision",
          "event_sequence",
          "audit_reference",
          "replayed"
        ],
        "properties": {
          "result_id": {
            "type": "string"
          },
          "result_revision": {
            "type": "integer"
          },
          "event_sequence": {
            "type": "integer"
          },
          "audit_reference": {
            "type": "string"
          },
          "replayed": {
            "type": "boolean"
          }
        }
      },
      "error_codes": [
        "stale_revision",
        "stream_sequence_conflict",
        "idempotency_key_conflict",
        "idempotency_key_payload_mismatch",
        "result_not_registered",
        "review_question_ambiguous",
        "review_question_unavailable",
        "evidence_invalid",
        "payload_invalid",
        "audit_result_identity_unavailable",
        "audit_store_unavailable",
        "store_closed"
      ],
      "atomicity_invariant": "No successful correction is persisted if its audit write fails. A failed commit leaves no partial state.",
      "maps_to": "app5_1_automated.commit_audit_decision -> audit_store.commit_correction"
    },
    {
      "method": "GET",
      "path": "/v1/results/{result_id}/events",
      "purpose": "Ordered, owner-scoped audit event history for one result stream.",
      "implemented": true,
      "auth_required": true,
      "tenant_scoped": true,
      "response_200": {
        "type": "object",
        "required": [
          "result_id",
          "events"
        ],
        "properties": {
          "result_id": {
            "type": "string"
          },
          "events": {
            "type": "array",
            "items": {
              "type": "object"
            }
          },
          "result_revision": {
            "type": "integer"
          }
        }
      },
      "error_codes": [
        "result_not_registered",
        "store_closed",
        "audit_store_unavailable"
      ]
    },
    {
      "method": "GET",
      "path": "/v1/results/{result_id}/projection",
      "purpose": "Derived current-state projection. NOT an independently editable grade source.",
      "implemented": true,
      "auth_required": true,
      "tenant_scoped": true,
      "response_200": {
        "type": "object",
        "required": [
          "result_id",
          "result_revision",
          "questions",
          "original_ai_output"
        ],
        "properties": {
          "result_id": {
            "type": "string"
          },
          "result_revision": {
            "type": "integer"
          },
          "questions": {
            "type": "array",
            "items": {
              "type": "object"
            }
          },
          "original_ai_output": {
            "type": "object"
          },
          "totals": {
            "type": "object"
          }
        }
      },
      "invariant": "Original AI marks are preserved and returned unchanged; corrected values sit alongside, never overwriting.",
      "error_codes": [
        "result_not_registered",
        "audit_store_unavailable"
      ]
    },
    {
      "method": "POST",
      "path": "/v1/results/{result_id}/approvals",
      "purpose": "The single teacher sign-off gate for a reviewed result.",
      "implemented": false,
      "auth_required": true,
      "tenant_scoped": true,
      "request": {
        "type": "object",
        "required": [
          "approved",
          "expected_revision"
        ],
        "properties": {
          "approved": {
            "type": "boolean"
          },
          "expected_revision": {
            "type": "integer"
          }
        }
      },
      "response_200": {
        "type": "object",
        "required": [
          "result_id",
          "approved",
          "approved_by",
          "approved_at"
        ],
        "properties": {
          "result_id": {
            "type": "string"
          },
          "approved": {
            "type": "boolean"
          },
          "approved_by": {
            "type": "string"
          },
          "approved_at": {
            "type": "string"
          }
        }
      },
      "note": "Exactly ONE sign-off gate exists. There is no grade-publication endpoint in this contract, because the application performs zero mutating Classroom/Drive calls.",
      "error_codes": [
        "stale_revision",
        "result_not_registered",
        "audit_store_unavailable"
      ]
    },
    {
      "method": "GET",
      "path": "/v1/healthz",
      "purpose": "Liveness/readiness probe. No data access.",
      "implemented": true,
      "auth_required": false,
      "tenant_scoped": false,
      "response_200": {
        "type": "object",
        "required": [
          "status"
        ],
        "properties": {
          "status": {
            "enum": [
              "ok"
            ]
          }
        }
      },
      "error_codes": []
    },
    {
      "method": "POST",
      "path": "/v1/documents",
      "purpose": "Upload one PDF as a raw application/pdf body. The server computes the sha256 document_digest (the client never chooses the key) and stores the bytes in the owner+tenant scoped development document store.",
      "implemented": true,
      "auth_required": true,
      "tenant_scoped": true,
      "dev_only_storage": true,
      "request": {
        "body": "raw application/pdf bytes, bounded by document_limits",
        "query": {
          "filename": {
            "type": "string",
            "maxLength": 256
          }
        }
      },
      "response_201": {
        "type": "object",
        "required": [
          "document_digest",
          "owner",
          "bytes",
          "stored"
        ],
        "properties": {
          "document_digest": {
            "type": "string"
          },
          "owner": {
            "type": "string"
          },
          "bytes": {
            "type": "integer"
          },
          "pages": {
            "type": [
              "integer",
              "null"
            ]
          },
          "kind": {
            "type": "string"
          },
          "stored": {
            "type": "boolean"
          }
        },
        "note": "An identical re-upload answers 200 with stored:false (content-addressed idempotency)."
      },
      "error_codes": [
        "payload_invalid",
        "document_too_large",
        "invalid_pdf",
        "encrypted_pdf",
        "too_many_pages",
        "unsupported_type",
        "dev_opt_in_required",
        "store_unusable"
      ]
    },
    {
      "method": "GET",
      "path": "/v1/documents/{document_digest}",
      "purpose": "Owner+tenant-scoped private read of the stored PDF bytes: application/pdf with private no-store and nosniff. No anonymous or signed-URL route exists.",
      "implemented": true,
      "auth_required": true,
      "tenant_scoped": true,
      "dev_only_storage": true,
      "response_200": {
        "type": "string",
        "format": "binary"
      },
      "error_codes": [
        "result_not_registered",
        "dev_opt_in_required",
        "store_unusable"
      ]
    },
    {
      "method": "POST",
      "path": "/v1/jobs",
      "purpose": "Create (or idempotently replay) one durable marking job for a document this owner already uploaded. job_id is minted server-side; the client supplies only the idempotency key and the document digest.",
      "implemented": true,
      "auth_required": true,
      "tenant_scoped": true,
      "dev_only_storage": true,
      "idempotent": true,
      "request": {
        "type": "object",
        "required": [
          "idempotency_key",
          "document_digest"
        ],
        "properties": {
          "idempotency_key": {
            "type": "string",
            "minLength": 8,
            "maxLength": 128
          },
          "document_digest": {
            "type": "string",
            "minLength": 64,
            "maxLength": 64
          }
        }
      },
      "response_201": {
        "$ref_job_payload": "see /v1/jobs/{job_id} response_200"
      },
      "response_200": {
        "$ref_job_payload": "replay: same job, current state, created:false"
      },
      "error_codes": [
        "payload_invalid",
        "result_not_registered",
        "idempotency_key_payload_mismatch",
        "dev_opt_in_required",
        "store_unusable"
      ]
    },
    {
      "method": "GET",
      "path": "/v1/jobs/{job_id}",
      "purpose": "Owner+tenant-scoped durable job status. A succeeded job also carries its question results as the marks-only projection (question number + awarded marks); student answers never appear on a status payload.",
      "implemented": true,
      "auth_required": true,
      "tenant_scoped": true,
      "dev_only_storage": true,
      "response_200": {
        "type": "object",
        "required": [
          "job_id",
          "status",
          "attempts",
          "max_attempts",
          "document_digest",
          "result_id",
          "error_code"
        ],
        "properties": {
          "job_id": {
            "type": "string"
          },
          "status": {
            "enum": [
              "queued",
              "running",
              "succeeded",
              "failed"
            ]
          },
          "attempts": {
            "type": "integer"
          },
          "max_attempts": {
            "type": "integer"
          },
          "document_digest": {
            "type": "string"
          },
          "result_id": {
            "type": [
              "string",
              "null"
            ]
          },
          "error_code": {
            "type": [
              "string",
              "null"
            ]
          },
          "questions": {
            "type": "array",
            "description": "SUCCEEDED jobs only, when the marks-only projection is readable; omitted otherwise rather than guessed.",
            "items": {
              "type": "object",
              "required": [
                "question_number",
                "awarded_marks"
              ],
              "properties": {
                "question_number": {
                  "type": "string"
                },
                "awarded_marks": {
                  "type": [
                    "number",
                    "null"
                  ]
                }
              }
            }
          }
        }
      },
      "error_codes": [
        "result_not_registered",
        "dev_opt_in_required",
        "store_unusable"
      ]
    },
    {
      "method": "POST",
      "path": "/v1/jobs/{job_id}/run",
      "purpose": "Synchronously execute one claimable job: lease-guarded claim, marking engine, then the SAME registration path as POST /v1/results. Development/demo executor only; a background worker is the production shape and is absent by design for the beta.",
      "implemented": true,
      "auth_required": true,
      "tenant_scoped": true,
      "dev_only_storage": true,
      "response_200": {
        "$ref_job_payload": "see /v1/jobs/{job_id} response_200"
      },
      "error_codes": [
        "result_not_registered",
        "model_unavailable",
        "manual_document_provenance_required",
        "original_output_invalid",
        "service_unavailable",
        "dev_opt_in_required",
        "store_unusable"
      ]
    },
    {
      "method": "POST",
      "path": "/v1/assignments",
      "purpose": "Create or replay one server-owned teacher assignment (contract v1.2, PROPOSED).",
      "implemented": true,
      "auth_required": true,
      "tenant_scoped": true,
      "idempotent": true,
      "request": {
        "type": "object",
        "required": [
          "title"
        ],
        "headers": {
          "Idempotency-Key": "required canonical carrier, 8..128 chars"
        },
        "properties": {
          "title": {
            "type": "string",
            "minLength": 1,
            "maxLength": 200,
            "description": "trimmed before validation; 1..200 chars after trimming"
          },
          "idempotency_key": {
            "type": "string",
            "description": "optional alias; must equal Idempotency-Key if both present"
          }
        }
      },
      "response_201": {
        "type": "object",
        "required": [
          "assignment_id",
          "title",
          "created_at"
        ],
        "properties": {
          "assignment_id": {
            "type": "string",
            "pattern": "^asg_[0-9a-f]{24}$"
          },
          "title": {
            "type": "string"
          },
          "created_at": {
            "type": "integer"
          }
        }
      },
      "response_200": "same body on same-key + same-title replay",
      "error_codes": [
        "payload_invalid",
        "idempotency_key_payload_mismatch",
        "store_unusable",
        "dev_opt_in_required"
      ],
      "invariant": "assignment_id is minted server-side; tenant/owner come only from the verified token."
    },
    {
      "method": "GET",
      "path": "/v1/assignments",
      "purpose": "Newest-first keyset page of the caller's own assignments (contract v1.2, PROPOSED).",
      "implemented": true,
      "auth_required": true,
      "tenant_scoped": true,
      "query": {
        "limit": "integer 1..100, default 50",
        "cursor": "opaque next_cursor; malformed => 400 payload_invalid"
      },
      "response_200": {
        "type": "object",
        "required": [
          "assignments",
          "next_cursor"
        ],
        "properties": {
          "assignments": {
            "type": "array",
            "items": {
              "type": "object"
            }
          },
          "next_cursor": {
            "type": [
              "string",
              "null"
            ]
          }
        }
      },
      "error_codes": [
        "payload_invalid",
        "store_unusable",
        "dev_opt_in_required"
      ]
    }
  ],
  "absent_by_design": {
    "grade_publication": "No POST/PUT/PATCH/DELETE to Classroom or Drive exists in the application. All five classroom_request call sites pass GET. Scores surface to the teacher for manual entry.",
    "payments": "Not in scope; separately gated.",
    "public_signups": "Not in scope; brand/claims/privacy gate is separate.",
    "production_marking_worker": "POST /v1/jobs/{job_id}/run executes a job synchronously inside the request as the development/demo executor. A background worker that polls and claims jobs is the production shape and does not exist yet; no claim is made that jobs run anywhere today.",
    "paid_engine_calls": "The real engine (marking_engine.build_engine) activates only behind AI_MARKER_ENGINE_REAL=1 with an API key and a configured mark scheme. No test, CI job or deployment spends provider tokens by default."
  }
}
